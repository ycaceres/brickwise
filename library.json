{
  "version": 1,
  "about": "Workout library. See the format in README.md, Library section.",
  "durations": [30, 45, 60],
  "defaults": {
    "warmup": { "dur": "10m", "pace": [70, 80], "ramp": true },
    "warmup30": { "dur": "8m", "pace": [70, 80], "ramp": true },
    "cooldown": { "dur": "5m", "pace": [78, 68], "ramp": true }
  },
  "types": [
    {
      "id": "recovery",
      "name": "Recovery",
      "description": "Very easy, to loosen the legs the day after a hard effort.",
      "warmup": { "dur": "5m", "pace": "11:00", "incline": 1 },
      "cooldown": { "dur": "5m", "pace": "11:00", "incline": 1 },
      "levels": {
        "1": { "kind": "continuous", "main": {"pace": "10:00", "incline": 1}, "summary": "brisk walk" },
        "2": {
          "kind": "intervals",
          "work": { "dur": "2m", "pace": [65, 70] },
          "recovery": { "dur": "2m", "pace": "10:00" },
          "summary": "very easy jog alternated with walking"
        },
        "3": { "kind": "continuous", "main": {"pace": [65, 72]}, "summary": "steady Z1 jog" },
        "4": { "kind": "continuous", "main": {"pace": [68, 75]}, "summary": "steady Z1 jog" },
        "5": {
          "kind": "continuous",
          "main": { "pace": [68, 75] },
          "finish": { "reps": 4, "work": {"dur": "1m", "pace": 95}, "recovery": {"dur": "1m", "pace": 68} },
          "summary": "Z1 jog and 4 × 1′ strides"
        }
      }
    },
    {
      "id": "run-walk",
      "name": "Run-walk",
      "description": "Z2 jog alternated with walking. For starting to run or coming back after a break.",
      "warmup": { "dur": "5m", "pace": "11:00", "incline": 1 },
      "cooldown": { "dur": "5m", "pace": "11:00", "incline": 1 },
      "levels": {
        "1": { "kind": "intervals", "work": {"dur": "1m", "pace": "Z2"}, "recovery": {"dur": "2m", "pace": "10:30"} },
        "2": { "kind": "intervals", "work": {"dur": "2m", "pace": "Z2"}, "recovery": {"dur": "2m", "pace": "10:30"} },
        "3": { "kind": "intervals", "work": {"dur": "4m", "pace": "Z2"}, "recovery": {"dur": "1m", "pace": "10:30"} },
        "4": { "kind": "intervals", "work": {"dur": "6m", "pace": "Z2"}, "recovery": {"dur": "1m", "pace": "10:30"} },
        "5": { "kind": "intervals", "work": {"dur": "8m", "pace": "Z2"}, "recovery": {"dur": "1m", "pace": "10:30"} }
      }
    },
    {
      "id": "walk-incline",
      "name": "Incline walk",
      "description": "Fixed speed; incline rises 0.5 % every minute and holds at the top. Z2 HR is the goal, speed never changes.",
      "warmup": { "dur": "5m", "pace": "12:00", "incline": 2, "lock": true },
      "cooldown": null,
      "levels": {
        "1": { "kind": "incline-ramp", "pace": "12:00", "from": 2.5, "to": 6, "step": 0.5, "every": "1m", "hr": "Z2" },
        "2": { "kind": "incline-ramp", "pace": "12:00", "from": 2.5, "to": 8, "step": 0.5, "every": "1m", "hr": "Z2" },
        "3": { "kind": "incline-ramp", "pace": "12:00", "from": 2.5, "to": 10, "step": 0.5, "every": "1m", "hr": "Z2" },
        "4": { "kind": "incline-ramp", "pace": "11:00", "from": 2.5, "to": 10, "step": 0.5, "every": "1m", "hr": "Z2" },
        "5": { "kind": "incline-ramp", "pace": "10:00", "from": 2.5, "to": 10, "step": 0.5, "every": "1m", "hr": "Z2" }
      }
    },
    {
      "id": "aerobic",
      "name": "Aerobic Z2",
      "description": "Steady run in pace zone 2: the foundation of endurance.",
      "levels": {
        "1": { "kind": "continuous", "main": {"pace": [78, 82]}, "summary": "low Z2" },
        "2": { "kind": "continuous", "main": {"pace": [80, 84]}, "summary": "mid Z2" },
        "3": { "kind": "continuous", "main": {"pace": [82, 86]}, "summary": "mid-high Z2" },
        "4": { "kind": "continuous", "main": {"pace": [84, 87.5]}, "summary": "high Z2" },
        "5": {
          "kind": "continuous",
          "main": { "pace": [84, 87.5] },
          "finish": { "reps": 6, "work": {"dur": "1m", "pace": 100}, "recovery": {"dur": "1m", "pace": 75} },
          "summary": "high Z2 and 6 × 1′ strides"
        }
      }
    },
    {
